# Configuration de production de TESLA — modèle SANS secret.
# Copier en /etc/tesla/production.env (propriétaire root:tesla, mode 0640), compléter les valeurs
# <…>, ne jamais versionner le fichier réel. Préproduction : /etc/tesla/preproduction.env, avec
# son propre domaine, sa propre base, son port (API_PORT=4100) et sa clé de sauvegarde.
# Architecture par défaut : web sur Vercel, API sur ce VPS (docs/DEPLOYMENT_VERCEL_OVH.md).

NODE_ENV=production
# vercel : le VPS ne sert que l'API (tesla-api@) ; local : mode historique, web servi par tesla-web@.
WEB_HOSTING=vercel
# Racine de déploiement (releases, current, repo) ; à ne changer qu'avec bootstrap.sh.
TESLA_DEPLOY_ROOT=/var/www/tesla
# Node.js de TESLA (node, npm, npx ≥ 22.12) pour les builds, Prisma et les services ; commun aux
# deux instances ; à ne changer qu'avec bootstrap.sh. /usr/bin/node (autres applications) n'est pas utilisé.
TESLA_NODE_DIR=/opt/node22/bin
# Adresse publique de CE serveur (domaine de l'API), utilisée par les contrôles de santé.
PUBLIC_URL=https://<domaine_api>

# API NestJS (écoute locale uniquement, derrière Nginx). Port libre sur le VPS : vérifié par
# bootstrap.sh (--api-port), jamais supposé disponible.
API_HOST=127.0.0.1
API_PORT=4000
TRUST_PROXY=true
# Origine EXACTE du web (Vercel), sans barre finale : contrôlée par la protection CSRF sur toute
# écriture. Jamais d'adresse de prévisualisation Vercel en production.
CORS_ORIGINS=https://<projet>.vercel.app
SWAGGER_ENABLED=false
SESSION_TTL_HOURS=12
ACCOUNT_LINK_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=60

# E-mails de compte (facultatif, D166) : sans ces variables, la récupération est administrée
# (lien et code remis par une personne habilitée) et aucun message ne prétend qu'un e-mail est parti.
# PUBLIC_APP_URL=https://<projet>.vercel.app
# SMTP_HOST=<serveur_smtp>
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=<identifiant>
# SMTP_PASSWORD=<secret>
# SMTP_FROM="Nikola Tesla Académie <no-reply@<domaine>>"

# PostgreSQL local (socket ou 127.0.0.1), rôle dédié non superutilisateur
DATABASE_URL=postgresql://tesla_production:<mot_de_passe>@127.0.0.1:5432/tesla_production?schema=public

# Web Next.js : uniquement en mode historique (WEB_HOSTING=local). Avec Vercel, ces variables se
# définissent dans le projet Vercel (NEXT_PUBLIC_API_URL=/api/v1, TESLA_API_ORIGIN,
# TESLA_PROXY_SECRET), jamais ici.
# WEB_PORT=3000
# NEXT_PUBLIC_API_URL=https://<domaine>/api/v1
NEXT_TELEMETRY_DISABLED=1

# Fiches médicales (D136) : clé à conserver AUSSI hors du VPS (coffre de l'association), séparément
# des sauvegardes ; sans elle, les fiches restaurées sont illisibles. openssl rand -base64 32
MEDICAL_DATA_KEY=<clé_base64_32_octets>

# Stockage objet des fichiers (Cloudflare R2, docs/STORAGE_R2.md). Jeton « Object Read & Write »
# limité au SEUL compartiment applicatif ; jamais le jeton des sauvegardes.
R2_ACCOUNT_ID=<identifiant_compte_cloudflare>
R2_ACCESS_KEY_ID=<clé_d_accès_du_jeton_applicatif>
R2_SECRET_ACCESS_KEY=<secret_du_jeton_applicatif>
R2_BUCKET_NAME=tesla-files-production
R2_KEY_PREFIX=production
R2_UPLOAD_MAX_BYTES=20971520
R2_SIGNED_URL_EXPIRATION=300

# Sauvegardes (deploy/scripts/backup.sh, D144). Remote rclone R2 configuré pour l'utilisateur tesla
# avec un jeton DISTINCT, limité au compartiment des sauvegardes (docs/STORAGE_R2.md § 7).
BACKUP_DIR=/var/backups/tesla/production
BACKUP_GPG_RECIPIENT=<empreinte_de_la_clé_publique_de_sauvegarde>
BACKUP_REMOTE=r2-backup:tesla-backups/production
# 0 = copie locale supprimée dès la copie distante vérifiée (préserve le disque du VPS) ; 2 = deux jours.
BACKUP_RETENTION_DAYS=2
BACKUP_MIN_FREE_MB=1024
# Copie chiffrée des fichiers applicatifs (lecture seule sur le compartiment applicatif).
# Obligatoire dès que R2_BUCKET_NAME est défini (sinon la sauvegarde échoue et alerte).
FILES_BACKUP_SOURCE=r2-files-ro:tesla-files-production
FILES_BACKUP_REMOTE=r2-backup-crypt:production-files
# Alertes : URL appelée (POST texte) quand le contrôle de santé, le traitement quotidien ou la
# sauvegarde échoue (tesla-alert@.service). Recommandé en production.
ALERT_URL=https://<service_d_alerte>/<canal>
# Après chaque sauvegarde réussie (détection d'absence par le service de surveillance).
# BACKUP_HEARTBEAT_URL=https://<service_de_surveillance>/<identifiant>
# Restauration d'essai avant chiffrement (rôle de maintenance avec CREATEDB, base « postgres »)
# BACKUP_RESTORE_CHECK_URL=postgresql://tesla_maintenance:<mot_de_passe>@127.0.0.1:5432/postgres

# Interdit en production : DEMO_ACCOUNT_PASSWORD (comptes de démonstration).
