# Configuration de production de TESLA — modèle SANS secret.
# Copier en /etc/tesla/production.env (propriétaire root:tesla, mode 0640), compléter les valeurs
# <…>, ne jamais versionner le fichier réel. Préproduction : /etc/tesla/preproduction.env, avec
# son propre domaine, sa propre base, ses ports (API_PORT=4100, WEB_PORT=3100) et sa clé de sauvegarde.

NODE_ENV=production
PUBLIC_URL=https://<domaine>

# API NestJS (écoute locale uniquement, derrière Nginx)
API_HOST=127.0.0.1
API_PORT=4000
TRUST_PROXY=true
CORS_ORIGINS=https://<domaine>
SWAGGER_ENABLED=false
SESSION_TTL_HOURS=12
ACCOUNT_LINK_TTL_HOURS=72

# PostgreSQL local (socket ou 127.0.0.1), rôle dédié non superutilisateur
DATABASE_URL=postgresql://tesla:<mot_de_passe>@127.0.0.1:5432/tesla?schema=public

# Web Next.js (NEXT_PUBLIC_API_URL est intégrée au build : rebuild si elle change)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://<domaine>/api/v1
NEXT_TELEMETRY_DISABLED=1

# Sauvegardes (deploy/scripts/backup.sh)
BACKUP_DIR=/var/backups/tesla/production
BACKUP_GPG_RECIPIENT=<empreinte_de_la_clé_publique_de_sauvegarde>
BACKUP_REMOTE=<remote_rclone>:tesla/production
BACKUP_RETENTION_DAYS=14
# Restauration d'essai avant chiffrement (rôle de maintenance avec CREATEDB, base « postgres »)
# BACKUP_RESTORE_CHECK_URL=postgresql://tesla_maintenance:<mot_de_passe>@127.0.0.1:5432/postgres

# Interdit en production : DEMO_ACCOUNT_PASSWORD (comptes de démonstration).
