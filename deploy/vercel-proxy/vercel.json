{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "routes": [
    {
      "src": "/(.*)",
      "dest": "https://tesla.veilleurdesmedias.org/$1",
      "headers": { "x-vercel-enable-rewrite-caching": "0" },
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-tesla-proxy-secret" },
          "args": "$TESLA_PROXY_SECRET",
          "env": ["TESLA_PROXY_SECRET"]
        }
      ]
    }
  ]
}
