# Traitement quotidien idempotent : sorties de branche échues, plans de rattrapage, purge des
# compteurs de connexion (npm run jobs:daily). Déclenché par tesla-daily@%i.timer.
[Unit]
OnFailure=tesla-alert@%p-%i.service
Description=TESLA — traitement quotidien (%i)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=tesla
Group=tesla
EnvironmentFile=/etc/tesla/%i.env
WorkingDirectory=/var/www/tesla/%i/current/apps/api
ExecStart=/usr/bin/node dist/jobs/daily.js
SyslogIdentifier=tesla-daily-%i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Isolation : seul le répertoire de l'instance est visible sous /var/www (autres applications
# du VPS masquées), en lecture seule.
TemporaryFileSystem=/var/www:ro
BindReadOnlyPaths=/var/www/tesla/%i
