# Frontend Next.js (PWA) de TESLA. Instance : production ou preproduction (%i).
# Mode historique (WEB_HOSTING=local) uniquement : avec WEB_HOSTING=vercel, le web est servi par
# Vercel et cette unité n'est ni activée ni démarrée (bootstrap.sh, deploy.sh).
[Unit]
Description=TESLA — Web (%i)
After=network-online.target tesla-api@%i.service
Wants=network-online.target

[Service]
Type=simple
User=tesla
Group=tesla
EnvironmentFile=/etc/tesla/%i.env
# Node.js de TESLA (TESLA_NODE_DIR, rendu par bootstrap.sh), jamais /usr/bin/node du système.
Environment=PATH=/opt/node22/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/var/www/tesla/%i/current/apps/web
ExecStart=/opt/node22/bin/node /var/www/tesla/%i/current/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port ${WEB_PORT}
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tesla-web-%i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Cache d'images et d'ISR de Next.js : seul répertoire inscriptible.
ReadWritePaths=-/var/www/tesla/%i/current/apps/web/.next/cache
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
MemoryMax=768M

[Install]
WantedBy=multi-user.target
