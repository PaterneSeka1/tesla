# Sauvegarde chiffrée de la base (deploy/scripts/backup.sh), copie hors VPS. Échec → unité « failed »,
# visible par systemctl --failed et la surveillance.
[Unit]
Description=TESLA — sauvegarde PostgreSQL (%i)
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=tesla
Group=tesla
EnvironmentFile=/etc/tesla/%i.env
ExecStart=/opt/tesla/%i/current/deploy/scripts/backup.sh
SyslogIdentifier=tesla-backup-%i
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/tesla/%i /home/tesla/.gnupg -/home/tesla/.config/rclone
