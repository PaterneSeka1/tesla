// Schéma de Nikola Tesla Académie.
// Conventions : identifiants UUID v7, tables/colonnes en snake_case, dates en UTC (timestamptz).
// Voir docs/DATABASE.md avant toute modification.

generator client {
  provider            = "prisma-client"
  previewFeatures     = ["partialIndexes"]
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Rôles applicatifs (synchronisés avec @tesla/shared ROLES).
enum Role {
  ROUTIER
  CHEF
  RESPONSABLE
}

/// Compte utilisateur. Un compte n'est jamais supprimé : il est désactivé (isActive = false).
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Stocké en minuscules (normalisation applicative).
  email        String    @unique
  /// Hash du mot de passe (algorithme défini en phase authentification). Null tant que le compte n'est pas activé.
  passwordHash String?   @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  role         Role
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions     Session[]
  scoutProfile ScoutProfile?
  auditLogs    AuditLog[]

  teamAssignmentsMade  TeamAssignment[]           @relation("TeamAssignmentAssignedBy")
  teamAssignmentsEnded TeamAssignment[]           @relation("TeamAssignmentEndedBy")
  evaluationsPublished EvaluationVersion[]        @relation("EvaluationVersionPublishedBy")
  attemptsCreated      EvaluationAttempt[]        @relation("AttemptCreatedBy")
  attemptsRecorded     EvaluationAttempt[]        @relation("AttemptRecordedBy")
  attemptsDecided      EvaluationAttempt[]        @relation("AttemptDecidedBy")
  attemptEvents        EvaluationAttemptEvent[]
  waiversGranted       EvaluationWaiver[]         @relation("WaiverGrantedBy")
  waiversRevoked       EvaluationWaiver[]         @relation("WaiverRevokedBy")
  observationsWritten  ScoutObservation[]
  observationRevisions ScoutObservationRevision[]

  modulesCreated             PedagogicalModule[]  @relation("ModuleCreatedBy")
  moduleVersionsCreated      ModuleVersion[]      @relation("ModuleVersionCreatedBy")
  moduleVersionsUpdated      ModuleVersion[]      @relation("ModuleVersionUpdatedBy")
  moduleVersionsSubmitted    ModuleVersion[]      @relation("ModuleVersionSubmittedBy")
  moduleVersionsApproved     ModuleVersion[]      @relation("ModuleVersionApprovedBy")
  moduleVersionsPublished    ModuleVersion[]      @relation("ModuleVersionPublishedBy")
  moduleLessonsCreated       ModuleLesson[]       @relation("ModuleLessonCreatedBy")
  moduleLessonsUpdated       ModuleLesson[]       @relation("ModuleLessonUpdatedBy")
  moduleResourcesCreated     ModuleResource[]
  moduleCollaborations       ModuleCollaborator[] @relation("ModuleCollaboratorUser")
  moduleCollaboratorsAdded   ModuleCollaborator[] @relation("ModuleCollaboratorAddedBy")
  moduleCollaboratorsRemoved ModuleCollaborator[] @relation("ModuleCollaboratorRemovedBy")
  moduleVersionEvents        ModuleVersionEvent[]

  evaluationsCreated          Evaluation[]             @relation("EvaluationCreatedBy")
  evaluationVersionsCreated   EvaluationVersion[]      @relation("EvaluationVersionCreatedBy")
  evaluationVersionsUpdated   EvaluationVersion[]      @relation("EvaluationVersionUpdatedBy")
  evaluationVersionsSubmitted EvaluationVersion[]      @relation("EvaluationVersionSubmittedBy")
  evaluationVersionsApproved  EvaluationVersion[]      @relation("EvaluationVersionApprovedBy")
  evaluationQuestionsCreated  EvaluationQuestion[]     @relation("EvaluationQuestionCreatedBy")
  evaluationQuestionsUpdated  EvaluationQuestion[]     @relation("EvaluationQuestionUpdatedBy")
  evaluationVersionEvents     EvaluationVersionEvent[]
  answersGraded               AttemptAnswer[]

  stageChangesDecided          ScoutStageChange[]
  competenciesCreated          Competency[]              @relation("CompetencyCreatedBy")
  competenciesUpdated          Competency[]              @relation("CompetencyUpdatedBy")
  competencyProposals          CompetencyProposal[]      @relation("CompetencyProposalProposedBy")
  competencyProposalsDecided   CompetencyProposal[]      @relation("CompetencyProposalDecidedBy")
  competencyProposalEvents     CompetencyProposalEvent[]
  competencyEvidencesAdded     CompetencyEvidence[]
  competencyValidationsDecided CompetencyValidation[]    @relation("CompetencyValidationDecidedBy")
  competencyValidationsRevoked CompetencyValidation[]    @relation("CompetencyValidationRevokedBy")
  moduleStudiesRecorded        ModuleStudy[]             @relation("ModuleStudyRecordedBy")
  moduleStudiesCancelled       ModuleStudy[]             @relation("ModuleStudyCancelledBy")
  programmeCategoriesUpdated   ProgrammeCategory[]
  activitiesCreated            Activity[]                @relation("ActivityCreatedBy")
  activitiesUpdated            Activity[]                @relation("ActivityUpdatedBy")
  activityEvents               ActivityEvent[]
  attendancesRecorded          ActivityAttendance[]

  @@index([role])
  @@map("users")
}

/// Session serveur (cookie httpOnly). Seul le hash du jeton est stocké.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Profil routier : référence métier (identité, matricule, équipe, progression, résultats).
/// Existe indépendamment de tout compte : `userId` est facultatif et rattachable plus tard (RM-001).
model ScoutProfile {
  id                String    @id @default(uuid(7)) @db.Uuid
  /// Compte de connexion facultatif (relation 1–1). Le rattachement ne crée jamais de second profil.
  userId            String?   @unique @map("user_id") @db.Uuid
  /// Matricule scout : chaîne normalisée (voir normalizeMatricule dans @tesla/shared), unique si renseigné (RM-002).
  matricule         String?   @unique
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  /// Utilisée uniquement pour les durées d'étape dépendant de l'âge (règle à arbitrer).
  birthDate         DateTime? @map("birth_date") @db.Date
  joinedAt          DateTime  @map("joined_at") @db.Date
  currentStageId    String?   @map("current_stage_id") @db.Uuid
  /// Date d'effet de l'étape courante (renseignée par chaque décision de l'historique des étapes).
  currentStageSince DateTime? @map("current_stage_since") @db.Date
  /// Profil désactivé (départ, inactivité) : conservé avec tout son historique, jamais supprimé.
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                  User?                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  currentStage          ProgressionStage?      @relation(fields: [currentStageId], references: [id], onDelete: Restrict)
  teamAssignments       TeamAssignment[]
  evaluationAttempts    EvaluationAttempt[]
  evaluationWaivers     EvaluationWaiver[]
  observations          ScoutObservation[]
  stageChanges          ScoutStageChange[]
  competencyProposals   CompetencyProposal[]
  competencyValidations CompetencyValidation[]
  moduleStudies         ModuleStudy[]
  attendances           ActivityAttendance[]

  @@index([currentStageId])
  @@index([isActive])
  @@index([lastName, firstName])
  @@map("scout_profiles")
}

/// Référentiel des étapes de progression (Noviciat → Départ routier).
/// Les durées dépendent de l'âge et ne sont pas encore modélisées (arbitrage en attente).
model ProgressionStage {
  id             String   @id @default(uuid(7)) @db.Uuid
  code           String   @unique
  name           String
  /// Libellé utilisé dans le programme annuel (ex. « Novices Routiers »).
  programmeLabel String   @map("programme_label")
  badge          String?
  position       Int      @unique
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  scoutProfiles       ScoutProfile[]
  evaluations         Evaluation[]
  moduleVersions      ModuleVersion[]
  stageChangesFrom    ScoutStageChange[]  @relation("StageChangeFrom")
  stageChangesTo      ScoutStageChange[]  @relation("StageChangeTo")
  competencies        Competency[]
  programmeCategories ProgrammeCategory[]

  @@map("progression_stages")
}

/// Journal d'audit en ajout seul : aucune mise à jour ni suppression applicative.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Null pour une action système (seed, tâche planifiée).
  actorId    String?  @map("actor_id") @db.Uuid
  /// Format « domaine.action », ex. « module.approved ».
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Équipe de la Communauté Nikola Tesla. Jamais supprimée : archivée (archivedAt).
model Team {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @unique
  description String?
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments TeamAssignment[]

  @@map("teams")
}

/// Historique des affectations d'un routier à une équipe (RM-003, RM-004).
/// Une seule affectation ouverte (endedAt null) par routier ; périodes sans chevauchement
/// (contrainte d'exclusion PostgreSQL ajoutée en SQL, voir docs/DATABASE.md).
model TeamAssignment {
  id             String    @id @default(uuid(7)) @db.Uuid
  scoutProfileId String    @map("scout_profile_id") @db.Uuid
  teamId         String    @map("team_id") @db.Uuid
  startedAt      DateTime  @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(3)
  /// Auteur de l'affectation (null = action système, ex. reprise de données).
  assignedById   String?   @map("assigned_by_id") @db.Uuid
  endedById      String?   @map("ended_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  scoutProfile ScoutProfile @relation(fields: [scoutProfileId], references: [id], onDelete: Restrict)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  assignedBy   User?        @relation("TeamAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  endedBy      User?        @relation("TeamAssignmentEndedBy", fields: [endedById], references: [id], onDelete: Restrict)

  @@unique([scoutProfileId], map: "team_assignments_one_open_per_scout", where: raw("ended_at IS NULL"))
  @@index([scoutProfileId, startedAt])
  @@index([teamId])
  @@map("team_assignments")
}

/// Mode de passation d'une évaluation.
enum EvaluationMode {
  EN_LIGNE
  HORS_LIGNE
  PAPIER
}

/// Cycle de vie d'une tentative. VALIDEE/REFUSEE = décision pédagogique du responsable sur ce résultat,
/// distincte de la validation officielle d'une étape (jamais déclenchée automatiquement).
enum AttemptStatus {
  PREPAREE
  EN_COURS
  A_CORRIGER
  SOUMISE
  VALIDEE
  REFUSEE
  ANNULEE
}

/// Évaluation rattachée à une étape de progression (condition d'éligibilité, RM-009).
/// Le lien vers le module de cours sera ajouté avec le modèle Module (phase 2).
/// Évaluation (questionnaire) stable. Son contenu est porté par ses versions ; seule la version désignée
/// par `publishedVersionId` peut être passée par les routiers (docs/FEATURES/EVALUATION_WORKFLOW.md).
model Evaluation {
  id                 String   @id @default(uuid(7)) @db.Uuid
  /// Numéro séquentiel attribué par PostgreSQL ; code interne affiché « EVAL-001 ».
  number             Int      @unique @default(autoincrement())
  /// Titre de la version publiée (ou du premier brouillon) : libellé de référence des listes et dérogations.
  title              String
  /// Étape à laquelle l'évaluation est destinée (éligibilité, RM-EVAL-002). Figée après la première publication.
  stageId            String   @map("stage_id") @db.Uuid
  /// Module pédagogique évalué (facultatif). Figé après la première publication.
  moduleId           String?  @map("module_id") @db.Uuid
  /// Null uniquement pour les évaluations antérieures à la phase 3.
  createdById        String?  @map("created_by_id") @db.Uuid
  /// Version publiée courante (au plus une ; null = évaluation non disponible).
  publishedVersionId String?  @unique @map("published_version_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stage            ProgressionStage         @relation(fields: [stageId], references: [id], onDelete: Restrict)
  module           PedagogicalModule?       @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  createdBy        User?                    @relation("EvaluationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedVersion EvaluationVersion?       @relation("EvaluationPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: Restrict)
  versions         EvaluationVersion[]      @relation("EvaluationVersions")
  attempts         EvaluationAttempt[]
  waivers          EvaluationWaiver[]
  events           EvaluationVersionEvent[]

  @@index([stageId])
  @@index([moduleId])
  @@index([createdById])
  @@map("evaluations")
}

/// Version figée d'un questionnaire. Une version publiée n'est plus modifiée : toute évolution crée une nouvelle version.
/// État éditorial d'une version de questionnaire : mêmes états et transitions que les modules
/// (trigger `evaluation_versions_guard`). Seul le responsable approuve, publie ou archive.
enum EvaluationVersionStatus {
  BROUILLON
  SOUMIS
  A_CORRIGER
  REFUSE
  APPROUVE
  PUBLIE
  ARCHIVE
}

/// Action enregistrée dans l'historique d'une version de questionnaire (ajout seul).
enum EvaluationVersionAction {
  CREEE
  SOUMISE
  REPRISE
  CORRECTIONS_DEMANDEES
  REFUSEE
  APPROUVEE
  PUBLIEE
  REMPLACEE
  ARCHIVEE
}

/// Types de questions. Les deux derniers exigent une correction humaine (aucune correction automatique du texte).
enum QuestionType {
  CHOIX_UNIQUE
  CHOIX_MULTIPLE
  VRAI_FAUX
  REPONSE_COURTE
  REPONSE_DEVELOPPEE
}

/// Notation d'une question à choix multiples (sans effet sur les autres types).
enum ScoringPolicy {
  TOUT_OU_RIEN
  CREDIT_PARTIEL
}

/// Version d'un questionnaire. Modifiable uniquement à l'état BROUILLON (trigger SQL) ; une tentative
/// référence toujours la version exacte passée, qui n'est jamais modifiée ni supprimée.
model EvaluationVersion {
  id               String                  @id @default(uuid(7)) @db.Uuid
  evaluationId     String                  @map("evaluation_id") @db.Uuid
  version          Int
  status           EvaluationVersionStatus @default(BROUILLON)
  title            String
  /// Consignes affichées au routier et imprimées sur la feuille.
  instructions     String                  @default("")
  /// Durée indicative en minutes (information, aucun minuteur imposé).
  durationMinutes  Int?                    @map("duration_minutes")
  /// Nombre maximal de tentatives non annulées par routier (null = sans limite).
  maxAttempts      Int?                    @map("max_attempts")
  /// Contrôle de concurrence optimiste des informations du brouillon.
  revision         Int                     @default(1)
  basedOnVersionId String?                 @map("based_on_version_id") @db.Uuid
  /// Version du module évalué en vigueur à la publication (cohérence module ↔ évaluation).
  moduleVersionId  String?                 @map("module_version_id") @db.Uuid
  /// Format antérieur à la phase 3 (questions en JSON) : conservé pour l'historique, plus utilisé.
  questions        Json?
  /// Format antérieur à la phase 3 (corrigé en JSON) : conservé pour l'historique, plus utilisé.
  answerKey        Json?                   @map("answer_key")
  /// Null uniquement pour les versions antérieures à la phase 3.
  createdById      String?                 @map("created_by_id") @db.Uuid
  updatedById      String?                 @map("updated_by_id") @db.Uuid
  submittedAt      DateTime?               @map("submitted_at") @db.Timestamptz(3)
  submittedById    String?                 @map("submitted_by_id") @db.Uuid
  submissionNote   String?                 @map("submission_note")
  approvedAt       DateTime?               @map("approved_at") @db.Timestamptz(3)
  approvedById     String?                 @map("approved_by_id") @db.Uuid
  publishedAt      DateTime?               @map("published_at") @db.Timestamptz(3)
  publishedById    String?                 @map("published_by_id") @db.Uuid
  archivedAt       DateTime?               @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  evaluation      Evaluation               @relation("EvaluationVersions", fields: [evaluationId], references: [id], onDelete: Restrict)
  publishedFor    Evaluation?              @relation("EvaluationPublishedVersion")
  basedOn         EvaluationVersion?       @relation("EvaluationVersionBasedOn", fields: [basedOnVersionId], references: [id], onDelete: Restrict)
  derivedVersions EvaluationVersion[]      @relation("EvaluationVersionBasedOn")
  moduleVersion   ModuleVersion?           @relation(fields: [moduleVersionId], references: [id], onDelete: Restrict)
  createdBy       User?                    @relation("EvaluationVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User?                    @relation("EvaluationVersionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  submittedBy     User?                    @relation("EvaluationVersionSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  approvedBy      User?                    @relation("EvaluationVersionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  publishedBy     User?                    @relation("EvaluationVersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  questionItems   EvaluationQuestion[]
  attempts        EvaluationAttempt[]
  events          EvaluationVersionEvent[]

  @@unique([evaluationId, version])
  /// Cible de la clé étrangère composite des tentatives (cohérence version ↔ évaluation).
  @@unique([id, evaluationId])
  /// Une seule version de travail (non close) par évaluation.
  @@unique([evaluationId], map: "evaluation_versions_one_working", where: raw("status = ANY (ARRAY['BROUILLON'::\"EvaluationVersionStatus\", 'SOUMIS'::\"EvaluationVersionStatus\", 'A_CORRIGER'::\"EvaluationVersionStatus\", 'APPROUVE'::\"EvaluationVersionStatus\"])"))
  /// Une seule version publiée par évaluation.
  @@unique([evaluationId], map: "evaluation_versions_one_published", where: raw("status = 'PUBLIE'::\"EvaluationVersionStatus\""))
  @@index([status])
  @@index([basedOnVersionId])
  @@index([moduleVersionId])
  @@map("evaluation_versions")
}

/// Question ordonnée d'une version. Écriture uniquement dans une version à l'état brouillon (trigger SQL).
model EvaluationQuestion {
  id             String        @id @default(uuid(7)) @db.Uuid
  versionId      String        @map("version_id") @db.Uuid
  /// Rang dans la version (0, 1, 2…), maintenu contigu par le service.
  position       Int
  type           QuestionType
  /// Énoncé en texte brut (jamais de HTML).
  prompt         String
  /// Barème de la question (points), confidentiel jusqu'à la correction.
  points         Decimal       @db.Decimal(6, 2)
  scoringPolicy  ScoringPolicy @default(TOUT_OU_RIEN) @map("scoring_policy")
  /// Critères de correction (corrigé réservé aux chefs et au responsable).
  guidance       String?
  /// Réponse ou éléments de réponse attendus pour une question ouverte (corrigé).
  expectedAnswer String?       @map("expected_answer")
  revision       Int           @default(1)
  createdById    String        @map("created_by_id") @db.Uuid
  updatedById    String?       @map("updated_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  version   EvaluationVersion        @relation(fields: [versionId], references: [id], onDelete: Restrict)
  createdBy User                     @relation("EvaluationQuestionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?                    @relation("EvaluationQuestionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  options   EvaluationAnswerOption[]
  answers   AttemptAnswer[]

  @@index([versionId, position])
  @@index([createdById])
  @@index([updatedById])
  @@map("evaluation_questions")
}

/// Proposition de réponse d'une question à choix. `isCorrect` fait partie du corrigé : jamais transmis au routier
/// avant la correction, jamais imprimé sur sa feuille.
model EvaluationAnswerOption {
  id         String   @id @default(uuid(7)) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  position   Int
  label      String
  isCorrect  Boolean  @map("is_correct")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  question EvaluationQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([questionId, position])
  @@map("evaluation_answer_options")
}

/// Historique des versions de questionnaire et des décisions du responsable (ajout seul, trigger SQL).
model EvaluationVersionEvent {
  id           String                   @id @default(uuid(7)) @db.Uuid
  evaluationId String                   @map("evaluation_id") @db.Uuid
  versionId    String                   @map("version_id") @db.Uuid
  actorId      String                   @map("actor_id") @db.Uuid
  action       EvaluationVersionAction
  fromStatus   EvaluationVersionStatus? @map("from_status")
  toStatus     EvaluationVersionStatus  @map("to_status")
  comment      String?
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  evaluation Evaluation        @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  version    EvaluationVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  actor      User              @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([evaluationId, createdAt])
  @@index([versionId, createdAt])
  @@index([actorId])
  @@map("evaluation_version_events")
}

/// Tentative d'évaluation, quel que soit le mode (RM-006 à RM-008, RM-011).
/// Référence le profil routier, jamais seulement le compte. `code` est attribué par le backend,
/// unique et immuable (trigger SQL) ; la tentative n'est jamais supprimée (annulation = statut ANNULEE).
model EvaluationAttempt {
  id                       String         @id @default(uuid(7)) @db.Uuid
  /// Code public de référence, ex. « NT-2027-000125 » (RM-007). N'est pas un secret.
  code                     String         @unique
  scoutProfileId           String         @map("scout_profile_id") @db.Uuid
  evaluationId             String         @map("evaluation_id") @db.Uuid
  evaluationVersionId      String         @map("evaluation_version_id") @db.Uuid
  mode                     EvaluationMode
  status                   AttemptStatus  @default(PREPAREE)
  /// Date prévue de passation (feuille papier).
  plannedFor               DateTime?      @map("planned_for") @db.Date
  /// Ouverture du questionnaire en ligne par le routier.
  startedAt                DateTime?      @map("started_at") @db.Timestamptz(3)
  /// Remise des réponses par le routier (en ligne) ; pour le papier, voir `completedAt`.
  submittedAt              DateTime?      @map("submitted_at") @db.Timestamptz(3)
  /// Contrôle de concurrence optimiste de la correction (incrémenté à chaque enregistrement).
  correctionRevision       Int            @default(1) @map("correction_revision")
  /// Date de réalisation par le routier.
  completedAt              DateTime?      @map("completed_at") @db.Timestamptz(3)
  /// Dernier enregistrement de la correction dans l'application.
  recordedAt               DateTime?      @map("recorded_at") @db.Timestamptz(3)
  /// Format antérieur à la phase 3 (réponses en JSON) : conservé pour l'historique ; voir `AttemptAnswer`.
  answers                  Json?
  score                    Decimal?       @db.Decimal(7, 2)
  maxScore                 Decimal?       @map("max_score") @db.Decimal(7, 2)
  observations             String?
  /// Clé de stockage de la copie numérisée (stockage des fichiers non encore développé).
  evidenceFileKey          String?        @map("evidence_file_key")
  /// Dérogation ayant permis la préparation hors progression, le cas échéant.
  waiverId                 String?        @map("waiver_id") @db.Uuid
  createdById              String         @map("created_by_id") @db.Uuid
  recordedById             String?        @map("recorded_by_id") @db.Uuid
  decidedById              String?        @map("decided_by_id") @db.Uuid
  decidedAt                DateTime?      @map("decided_at") @db.Timestamptz(3)
  decisionComment          String?        @map("decision_comment")
  cancelledAt              DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelReason             String?        @map("cancel_reason")
  /// Réservation hors ligne (phase 5) : autorisation opaque, délai, idempotence et horodatages distincts.
  offlineAuthorization     String?        @unique @map("offline_authorization") @db.Uuid
  offlineIssuedAt          DateTime?      @map("offline_issued_at") @db.Timestamptz(3)
  offlineExpiresAt         DateTime?      @map("offline_expires_at") @db.Timestamptz(3)
  offlineOperationId       String?        @unique @map("offline_operation_id") @db.Uuid
  offlinePayloadHash       String?        @map("offline_payload_hash")
  offlineDeviceSubmittedAt DateTime?      @map("offline_device_submitted_at") @db.Timestamptz(3)
  offlineReceivedAt        DateTime?      @map("offline_received_at") @db.Timestamptz(3)
  offlineDecidedAt         DateTime?      @map("offline_decided_at") @db.Timestamptz(3)
  offlineDecisionCode      String?        @map("offline_decision_code")
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  scoutProfile   ScoutProfile             @relation(fields: [scoutProfileId], references: [id], onDelete: Restrict)
  evaluation     Evaluation               @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  version        EvaluationVersion        @relation(fields: [evaluationVersionId, evaluationId], references: [id, evaluationId], onDelete: Restrict)
  waiver         EvaluationWaiver?        @relation(fields: [waiverId], references: [id], onDelete: Restrict)
  createdBy      User                     @relation("AttemptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  recordedBy     User?                    @relation("AttemptRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  decidedBy      User?                    @relation("AttemptDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  events         EvaluationAttemptEvent[]
  attemptAnswers AttemptAnswer[]
  evidences      CompetencyEvidence[]

  /// Prévention des doublons (RM-012) : une seule tentative non clôturée par routier et par évaluation.
  /// Prédicat écrit sous la forme canonique de PostgreSQL pour éviter une fausse dérive du diff Prisma.
  @@unique([scoutProfileId, evaluationId], map: "evaluation_attempts_one_open_per_scout", where: raw("status = ANY (ARRAY['PREPAREE'::\"AttemptStatus\", 'EN_COURS'::\"AttemptStatus\", 'A_CORRIGER'::\"AttemptStatus\", 'SOUMISE'::\"AttemptStatus\"])"))
  @@index([scoutProfileId, createdAt])
  @@index([evaluationId])
  @@index([evaluationVersionId, evaluationId])
  @@index([status])
  @@index([waiverId])
  @@map("evaluation_attempts")
}

/// Historique en ajout seul d'une tentative : changements de statut, saisies et corrections (réponses originales conservées).
/// Réponse d'un routier à une question et sa correction. Rattachée à la tentative (donc au profil routier
/// et à la version exacte). Modifiable seulement tant que la tentative est ouverte à la saisie (trigger SQL).
model AttemptAnswer {
  id                String    @id @default(uuid(7)) @db.Uuid
  attemptId         String    @map("attempt_id") @db.Uuid
  questionId        String    @map("question_id") @db.Uuid
  /// Propositions choisies (questions à choix).
  selectedOptionIds String[]  @map("selected_option_ids") @db.Uuid
  /// Réponse rédigée (questions ouvertes) ou transcrite depuis la feuille papier.
  textAnswer        String?   @map("text_answer")
  /// Points attribués : calculés pour les questions objectives, saisis par un correcteur pour les autres.
  awardedPoints     Decimal?  @map("awarded_points") @db.Decimal(6, 2)
  /// Vrai si `awardedPoints` provient du moteur de correction déterministe.
  autoScored        Boolean   @default(false) @map("auto_scored")
  /// Appréciation et observation du correcteur (réponses ouvertes).
  appreciation      String?
  graderComment     String?   @map("grader_comment")
  gradedById        String?   @map("graded_by_id") @db.Uuid
  gradedAt          DateTime? @map("graded_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  attempt  EvaluationAttempt  @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  question EvaluationQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  gradedBy User?              @relation(fields: [gradedById], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([gradedById])
  @@map("attempt_answers")
}

model EvaluationAttemptEvent {
  id         String         @id @default(uuid(7)) @db.Uuid
  attemptId  String         @map("attempt_id") @db.Uuid
  actorId    String         @map("actor_id") @db.Uuid
  fromStatus AttemptStatus? @map("from_status")
  toStatus   AttemptStatus  @map("to_status")
  /// Motif obligatoire pour une correction après soumission, une annulation ou une réouverture.
  reason     String?
  /// Valeurs saisies à ce moment (réponses, score, observations, date de réalisation).
  snapshot   Json?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  attempt EvaluationAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  actor   User              @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([attemptId, createdAt])
  @@index([actorId])
  @@map("evaluation_attempt_events")
}

/// Compteur annuel des codes de tentative (RM-007). Incrémenté atomiquement dans la transaction de création.
model AttemptCodeCounter {
  year      Int      @id
  lastValue Int      @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("attempt_code_counters")
}

/// Dérogation (déblocage individuel) accordée par le responsable pour une évaluation hors progression (RM-009).
model EvaluationWaiver {
  id               String    @id @default(uuid(7)) @db.Uuid
  scoutProfileId   String    @map("scout_profile_id") @db.Uuid
  evaluationId     String    @map("evaluation_id") @db.Uuid
  reason           String
  grantedById      String    @map("granted_by_id") @db.Uuid
  grantedAt        DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById      String?   @map("revoked_by_id") @db.Uuid
  revocationReason String?   @map("revocation_reason")

  scoutProfile ScoutProfile        @relation(fields: [scoutProfileId], references: [id], onDelete: Restrict)
  evaluation   Evaluation          @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  grantedBy    User                @relation("WaiverGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy    User?               @relation("WaiverRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  attempts     EvaluationAttempt[]

  @@index([scoutProfileId, evaluationId])
  @@index([evaluationId])
  @@map("evaluation_waivers")
}

/// Niveau d'accès d'une observation pédagogique (aucune observation n'est visible des routiers).
enum ObservationVisibility {
  /// Chefs et responsable.
  ENCADREMENT
  /// Responsable et auteur uniquement.
  RESPONSABLE
}

/// Observation d'accompagnement saisie par un chef ou le responsable sur un routier.
/// Information pédagogique, jamais une validation officielle. Jamais supprimée (trigger) ;
/// chaque modification conserve l'état précédent dans `scout_observation_revisions`.
model ScoutObservation {
  id             String                @id @default(uuid(7)) @db.Uuid
  scoutProfileId String                @map("scout_profile_id") @db.Uuid
  authorId       String                @map("author_id") @db.Uuid
  /// Date de l'observation (fait observé), distincte de la date de saisie.
  observedOn     DateTime              @map("observed_on") @db.Date
  content        String
  /// Libellé libre facultatif (aucune liste de catégories n'a été arbitrée).
  category       String?
  visibility     ObservationVisibility @default(ENCADREMENT)
  /// Date de la dernière modification du contenu (null si jamais modifiée).
  editedAt       DateTime?             @map("edited_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  scoutProfile ScoutProfile               @relation(fields: [scoutProfileId], references: [id], onDelete: Restrict)
  author       User                       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  revisions    ScoutObservationRevision[]
  evidences    CompetencyEvidence[]

  @@index([scoutProfileId, observedOn])
  @@index([authorId])
  @@map("scout_observations")
}

/// État d'une observation avant chaque modification (ajout seul, trigger SQL).
model ScoutObservationRevision {
  id            String                @id @default(uuid(7)) @db.Uuid
  observationId String                @map("observation_id") @db.Uuid
  /// Auteur de la modification ayant remplacé cet état.
  editorId      String                @map("editor_id") @db.Uuid
  observedOn    DateTime              @map("observed_on") @db.Date
  content       String
  category      String?
  visibility    ObservationVisibility
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  observation ScoutObservation @relation(fields: [observationId], references: [id], onDelete: Restrict)
  editor      User             @relation(fields: [editorId], references: [id], onDelete: Restrict)

  @@index([observationId, createdAt])
  @@index([editorId])
  @@map("scout_observation_revisions")
}

/// État éditorial d'une version de module (docs/FEATURES/WORKFLOW_PUBLICATION.md).
/// Seul le responsable fait passer une version de SOUMIS à APPROUVE, A_CORRIGER ou REFUSE, puis à PUBLIE ou ARCHIVE.
enum ModuleVersionStatus {
  BROUILLON
  SOUMIS
  A_CORRIGER
  REFUSE
  APPROUVE
  PUBLIE
  ARCHIVE
}

/// Action enregistrée dans l'historique d'une version (ajout seul).
enum ModuleVersionAction {
  CREEE
  SOUMISE
  REPRISE
  CORRECTIONS_DEMANDEES
  REFUSEE
  APPROUVEE
  PUBLIEE
  REMPLACEE
  ARCHIVEE
}

/// Nature d'une ressource pédagogique : toujours une URL externe (aucun fichier lourd stocké sur le serveur).
enum ModuleResourceKind {
  IMAGE
  DOCUMENT
  VIDEO
  LIEN
}

/// Module pédagogique stable. Son contenu est porté par ses versions ; seule la version désignée par
/// `publishedVersionId` est visible des routiers.
model PedagogicalModule {
  id                 String   @id @default(uuid(7)) @db.Uuid
  /// Numéro séquentiel attribué par PostgreSQL ; code interne affiché « MOD-001 ».
  number             Int      @unique @default(autoincrement())
  /// Identifiant d'URL fixé à la création, stable même si le titre change dans une version ultérieure.
  slug               String   @unique
  createdById        String   @map("created_by_id") @db.Uuid
  /// Version publiée courante (au plus une ; null = module invisible des routiers).
  publishedVersionId String?  @unique @map("published_version_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy        User                 @relation("ModuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedVersion ModuleVersion?       @relation("ModulePublishedVersion", fields: [publishedVersionId], references: [id], onDelete: Restrict)
  versions         ModuleVersion[]      @relation("ModuleVersions")
  collaborators    ModuleCollaborator[]
  events           ModuleVersionEvent[]
  evaluations      Evaluation[]
  competencies     CompetencyModule[]
  studies          ModuleStudy[]
  activities       ActivityModule[]

  @@index([createdById])
  @@map("pedagogical_modules")
}

/// Version éditoriale d'un module. Modifiable uniquement à l'état BROUILLON (trigger SQL) ;
/// toute modification d'un module publié passe par une nouvelle version.
model ModuleVersion {
  id               String              @id @default(uuid(7)) @db.Uuid
  moduleId         String              @map("module_id") @db.Uuid
  version          Int
  status           ModuleVersionStatus @default(BROUILLON)
  title            String
  summary          String              @default("")
  objectives       String[]
  prerequisites    String?
  /// Durée indicative en minutes.
  durationMinutes  Int?                @map("duration_minutes")
  /// Étape recommandée (information de lecture : la consultation n'est jamais bloquée par la progression).
  stageId          String?             @map("stage_id") @db.Uuid
  /// Thème : libellé libre facultatif (aucune liste officielle arbitrée).
  theme            String?
  /// Contrôle de concurrence optimiste : incrémenté à chaque modification des informations du brouillon.
  revision         Int                 @default(1)
  /// Version dont le contenu a été repris à la création.
  basedOnVersionId String?             @map("based_on_version_id") @db.Uuid
  createdById      String              @map("created_by_id") @db.Uuid
  updatedById      String?             @map("updated_by_id") @db.Uuid
  submittedAt      DateTime?           @map("submitted_at") @db.Timestamptz(3)
  submittedById    String?             @map("submitted_by_id") @db.Uuid
  submissionNote   String?             @map("submission_note")
  approvedAt       DateTime?           @map("approved_at") @db.Timestamptz(3)
  approvedById     String?             @map("approved_by_id") @db.Uuid
  publishedAt      DateTime?           @map("published_at") @db.Timestamptz(3)
  publishedById    String?             @map("published_by_id") @db.Uuid
  /// Date de retrait (archivage ou remplacement par une nouvelle version publiée).
  archivedAt       DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  module             PedagogicalModule    @relation("ModuleVersions", fields: [moduleId], references: [id], onDelete: Restrict)
  publishedFor       PedagogicalModule?   @relation("ModulePublishedVersion")
  stage              ProgressionStage?    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  basedOn            ModuleVersion?       @relation("ModuleVersionBasedOn", fields: [basedOnVersionId], references: [id], onDelete: Restrict)
  derivedVersions    ModuleVersion[]      @relation("ModuleVersionBasedOn")
  createdBy          User                 @relation("ModuleVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy          User?                @relation("ModuleVersionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  submittedBy        User?                @relation("ModuleVersionSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  approvedBy         User?                @relation("ModuleVersionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  publishedBy        User?                @relation("ModuleVersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  lessons            ModuleLesson[]
  resources          ModuleResource[]
  events             ModuleVersionEvent[]
  evaluationVersions EvaluationVersion[]
  studies            ModuleStudy[]

  @@unique([moduleId, version])
  /// Une seule version de travail (non close) par module.
  @@unique([moduleId], map: "module_versions_one_working_per_module", where: raw("status = ANY (ARRAY['BROUILLON'::\"ModuleVersionStatus\", 'SOUMIS'::\"ModuleVersionStatus\", 'A_CORRIGER'::\"ModuleVersionStatus\", 'APPROUVE'::\"ModuleVersionStatus\"])"))
  /// Une seule version publiée par module.
  @@unique([moduleId], map: "module_versions_one_published_per_module", where: raw("status = 'PUBLIE'::\"ModuleVersionStatus\""))
  @@index([status])
  @@index([stageId])
  @@index([basedOnVersionId])
  @@map("module_versions")
}

/// Leçon ordonnée d'une version. Contenu : document structuré (JSON) validé par liste blanche, jamais du HTML.
model ModuleLesson {
  id              String   @id @default(uuid(7)) @db.Uuid
  versionId       String   @map("version_id") @db.Uuid
  /// Rang dans la version (0, 1, 2…), maintenu contigu par le service.
  position        Int
  title           String
  content         Json
  durationMinutes Int?     @map("duration_minutes")
  /// Contrôle de concurrence optimiste de la leçon.
  revision        Int      @default(1)
  createdById     String   @map("created_by_id") @db.Uuid
  updatedById     String?  @map("updated_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  version   ModuleVersion    @relation(fields: [versionId], references: [id], onDelete: Restrict)
  createdBy User             @relation("ModuleLessonCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?            @relation("ModuleLessonUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  resources ModuleResource[]

  @@index([versionId, position])
  @@index([createdById])
  @@index([updatedById])
  @@map("module_lessons")
}

/// Ressource associée à une version (ou à une de ses leçons) : URL externe uniquement.
model ModuleResource {
  id          String             @id @default(uuid(7)) @db.Uuid
  versionId   String             @map("version_id") @db.Uuid
  /// Null = ressource du module ; sinon ressource de la leçon.
  lessonId    String?            @map("lesson_id") @db.Uuid
  kind        ModuleResourceKind
  title       String
  url         String
  description String?
  createdById String             @map("created_by_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  version   ModuleVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  lesson    ModuleLesson? @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  createdBy User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([versionId])
  @@index([lessonId])
  @@index([createdById])
  @@map("module_resources")
}

/// Chef autorisé à rédiger un module (en plus de son auteur). Retrait daté, jamais supprimé.
model ModuleCollaborator {
  id          String    @id @default(uuid(7)) @db.Uuid
  moduleId    String    @map("module_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  addedById   String    @map("added_by_id") @db.Uuid
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(3)
  removedById String?   @map("removed_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  module    PedagogicalModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  user      User              @relation("ModuleCollaboratorUser", fields: [userId], references: [id], onDelete: Restrict)
  addedBy   User              @relation("ModuleCollaboratorAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  removedBy User?             @relation("ModuleCollaboratorRemovedBy", fields: [removedById], references: [id], onDelete: Restrict)

  @@unique([moduleId, userId], map: "module_collaborators_one_active", where: raw("removed_at IS NULL"))
  @@index([userId])
  @@index([addedById])
  @@index([removedById])
  @@map("module_collaborators")
}

/// Historique des versions et des décisions (ajout seul, trigger SQL).
model ModuleVersionEvent {
  id         String               @id @default(uuid(7)) @db.Uuid
  moduleId   String               @map("module_id") @db.Uuid
  versionId  String               @map("version_id") @db.Uuid
  actorId    String               @map("actor_id") @db.Uuid
  action     ModuleVersionAction
  fromStatus ModuleVersionStatus? @map("from_status")
  toStatus   ModuleVersionStatus  @map("to_status")
  /// Motif (obligatoire pour une demande de correction, un refus ou un archivage) ou note de soumission.
  comment    String?
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  module  PedagogicalModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  version ModuleVersion     @relation(fields: [versionId], references: [id], onDelete: Restrict)
  actor   User              @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([moduleId, createdAt])
  @@index([versionId, createdAt])
  @@index([actorId])
  @@index([createdAt])
  @@map("module_version_events")
}

// ─── Phase 4 : progression, compétences, programme annuel, activités ─────────────
// Voir docs/FEATURES/PROGRESSION.md, COMPETENCES.md, PROGRAMME_ANNUEL.md, SUIVI_ACTIVITES.md.

/// Nature d'une entrée de l'historique des étapes.
enum StageChangeKind {
  /// Étape initiale saisie à l'inscription.
  INSCRIPTION
  /// Décision motivée du responsable.
  DECISION
  /// Correction exceptionnelle d'une décision antérieure (référencée, jamais supprimée).
  CORRECTION
  /// Changement antérieur à la phase 4, repris du journal d'audit (motif non saisi à l'époque).
  REPRISE
}

/// Historique immuable des étapes d'un routier (ajout seul, trigger). Chaque entrée est écrite dans la
/// même transaction que la mise à jour de `scout_profiles.current_stage_id`.
model ScoutStageChange {
  id                String          @id @default(uuid(7)) @db.Uuid
  scoutProfileId    String          @map("scout_profile_id") @db.Uuid
  kind              StageChangeKind
  fromStageId       String?         @map("from_stage_id") @db.Uuid
  toStageId         String?         @map("to_stage_id") @db.Uuid
  /// Date d'effet (date de la cérémonie ou de la décision).
  effectiveOn       DateTime        @map("effective_on") @db.Date
  /// Null uniquement pour une reprise sans auteur connu.
  decidedById       String?         @map("decided_by_id") @db.Uuid
  reason            String
  observations      String?
  /// Éléments justificatifs examinés (texte libre : compétences, évaluations, observations).
  evidence          String?
  ceremonyReference String?         @map("ceremony_reference")
  /// Décision corrigée par cette entrée (CORRECTION uniquement).
  correctsChangeId  String?         @unique @map("corrects_change_id") @db.Uuid
  decidedAt         DateTime        @default(now()) @map("decided_at") @db.Timestamptz(3)

  scoutProfile ScoutProfile      @relation(fields: [scoutProfileId], references: [id], onDelete: Restrict)
  fromStage    ProgressionStage? @relation("StageChangeFrom", fields: [fromStageId], references: [id], onDelete: Restrict)
  toStage      ProgressionStage? @relation("StageChangeTo", fields: [toStageId], references: [id], onDelete: Restrict)
  decidedBy    User?             @relation(fields: [decidedById], references: [id], onDelete: Restrict)
  corrects     ScoutStageChange? @relation("StageChangeCorrection", fields: [correctsChangeId], references: [id], onDelete: Restrict)
  correctedBy  ScoutStageChange? @relation("StageChangeCorrection")

  @@index([scoutProfileId, decidedAt])
  @@index([fromStageId])
  @@index([toStageId])
  @@index([decidedById])
  @@map("scout_stage_changes")
}

/// Compétence du référentiel administrable. Aucune compétence n'est créée automatiquement :
/// le référentiel est saisi par le responsable.
model Competency {
  id                 String   @id @default(uuid(7)) @db.Uuid
  /// Code lisible choisi par le responsable (ex. « SERV-01 »), unique.
  code               String   @unique
  name               String
  description        String   @default("")
  /// Domaine en libellé libre (aucune liste officielle arbitrée).
  domain             String?
  stageId            String?  @map("stage_id") @db.Uuid
  observableCriteria String[] @map("observable_criteria")
  /// Nombre minimal d'éléments justificatifs exigés pour soumettre une proposition (fixé par le responsable).
  minEvidenceCount   Int      @default(1) @map("min_evidence_count")
  isActive           Boolean  @default(true) @map("is_active")
  position           Int      @default(0)
  createdById        String   @map("created_by_id") @db.Uuid
  updatedById        String?  @map("updated_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stage       ProgressionStage?      @relation(fields: [stageId], references: [id], onDelete: Restrict)
  createdBy   User                   @relation("CompetencyCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User?                  @relation("CompetencyUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  modules     CompetencyModule[]
  activities  ActivityCompetency[]
  proposals   CompetencyProposal[]
  validations CompetencyValidation[]

  @@index([stageId, position])
  @@index([isActive])
  @@map("competencies")
}

/// Modules pédagogiques associés à une compétence.
model CompetencyModule {
  competencyId String   @map("competency_id") @db.Uuid
  moduleId     String   @map("module_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  competency Competency        @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  module     PedagogicalModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@id([competencyId, moduleId])
  @@index([moduleId])
  @@map("competency_modules")
}

/// État d'une proposition de validation (chef → responsable).
enum CompetencyProposalStatus {
  EN_ATTENTE
  COMPLEMENT_DEMANDE
  APPROUVEE
  REFUSEE
  RETIREE
}

enum CompetencyProposalAction {
  SOUMISE
  PREUVE_AJOUTEE
  COMPLEMENT_DEMANDE
  RESOUMISE
  APPROUVEE
  REFUSEE
  RETIREE
}

/// Proposition de validation d'une compétence, appuyée sur des éléments observables.
/// Au plus une proposition ouverte par routier et par compétence (index unique partiel).
model CompetencyProposal {
  id              String                   @id @default(uuid(7)) @db.Uuid
  scoutProfileId  String                   @map("scout_profile_id") @db.Uuid
  competencyId    String                   @map("competency_id") @db.Uuid
  proposedById    String                   @map("proposed_by_id") @db.Uuid
  status          CompetencyProposalStatus @default(EN_ATTENTE)
  justification   String
  /// Dernier commentaire du responsable (demande de complément, refus, approbation).
  decisionComment String?                  @map("decision_comment")
  decidedById     String?                  @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?                @map("decided_at") @db.Timestamptz(3)
  /// Concurrence optimiste (ajout de preuves, décision).
  revision        Int                      @default(1)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  scoutProfile ScoutProfile              @relation(fields: [scoutProfileId], references: [id], onDelete: Restrict)
  competency   Competency                @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  proposedBy   User                      @relation("CompetencyProposalProposedBy", fields: [proposedById], references: [id], onDelete: Restrict)
  decidedBy    User?                     @relation("CompetencyProposalDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  evidences    CompetencyEvidence[]
  events       CompetencyProposalEvent[]
  validation   CompetencyValidation?

  @@unique([scoutProfileId, competencyId], map: "competency_proposals_one_open", where: raw("status = ANY (ARRAY['EN_ATTENTE'::\"CompetencyProposalStatus\", 'COMPLEMENT_DEMANDE'::\"CompetencyProposalStatus\"])"))
  @@index([status, createdAt])
  @@index([competencyId])
  @@index([proposedById])
  @@index([decidedById])
  @@map("competency_proposals")
}

/// Historique d'une proposition (ajout seul, trigger).
model CompetencyProposalEvent {
  id         String                    @id @default(uuid(7)) @db.Uuid
  proposalId String                    @map("proposal_id") @db.Uuid
  actorId    String                    @map("actor_id") @db.Uuid
  action     CompetencyProposalAction
  fromStatus CompetencyProposalStatus? @map("from_status")
  toStatus   CompetencyProposalStatus  @map("to_status")
  comment    String?
  createdAt  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  proposal CompetencyProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  actor    User               @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([proposalId, createdAt])
  @@index([actorId])
  @@map("competency_proposal_events")
}

/// Nature d'un élément justificatif.
enum EvidenceKind {
  OBSERVATION
  EVALUATION
  ACTIVITE
  ETUDE_MODULE
  AUTRE
}

/// Élément justificatif d'une proposition : référence à une donnée existante du même routier,
/// ou description libre (AUTRE). Jamais supprimé (trigger).
model CompetencyEvidence {
  id            String       @id @default(uuid(7)) @db.Uuid
  proposalId    String       @map("proposal_id") @db.Uuid
  kind          EvidenceKind
  observationId String?      @map("observation_id") @db.Uuid
  attemptId     String?      @map("attempt_id") @db.Uuid
  activityId    String?      @map("activity_id") @db.Uuid
  moduleStudyId String?      @map("module_study_id") @db.Uuid
  description   String?
  addedById     String       @map("added_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  proposal    CompetencyProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  observation ScoutObservation?  @relation(fields: [observationId], references: [id], onDelete: Restrict)
  attempt     EvaluationAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  activity    Activity?          @relation(fields: [activityId], references: [id], onDelete: Restrict)
  moduleStudy ModuleStudy?       @relation(fields: [moduleStudyId], references: [id], onDelete: Restrict)
  addedBy     User               @relation(fields: [addedById], references: [id], onDelete: Restrict)

  @@index([proposalId])
  @@index([observationId])
  @@index([attemptId])
  @@index([activityId])
  @@index([moduleStudyId])
  @@index([addedById])
  @@map("competency_evidences")
}

/// Décision officielle du responsable sur une compétence.
enum CompetencyDecision {
  ACQUIS
  A_RETRAVAILLER
}

/// Validation officielle d'une compétence (acte humain du responsable). Jamais supprimée : une
/// erreur se corrige par révocation motivée (trigger). Au plus une validation ACQUIS active par
/// routier et par compétence (index unique partiel).
model CompetencyValidation {
  id               String             @id @default(uuid(7)) @db.Uuid
  scoutProfileId   String             @map("scout_profile_id") @db.Uuid
  competencyId     String             @map("competency_id") @db.Uuid
  proposalId       String             @unique @map("proposal_id") @db.Uuid
  decision         CompetencyDecision
  justification    String
  /// Instantané des éléments examinés au moment de la décision.
  examinedEvidence Json               @map("examined_evidence")
  decidedById      String             @map("decided_by_id") @db.Uuid
  decidedAt        DateTime           @default(now()) @map("decided_at") @db.Timestamptz(3)
  revokedAt        DateTime?          @map("revoked_at") @db.Timestamptz(3)
  revokedById      String?            @map("revoked_by_id") @db.Uuid
  revocationReason String?            @map("revocation_reason")

  scoutProfile ScoutProfile       @relation(fields: [scoutProfileId], references: [id], onDelete: Restrict)
  competency   Competency         @relation(fields: [competencyId], references: [id], onDelete: Restrict)
  proposal     CompetencyProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  decidedBy    User               @relation("CompetencyValidationDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  revokedBy    User?              @relation("CompetencyValidationRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  @@unique([scoutProfileId, competencyId], map: "competency_validations_one_active_acquired", where: raw("decision = 'ACQUIS'::\"CompetencyDecision\" AND revoked_at IS NULL"))
  @@index([scoutProfileId, decidedAt])
  @@index([competencyId])
  @@index([decidedById])
  @@index([revokedById])
  @@map("competency_validations")
}

/// Modalité d'étude d'un module.
enum StudyMode {
  LECTURE_NUMERIQUE
  LECTURE_HORS_LIGNE
  COURS_PAPIER
  FORMATION_COLLECTIVE
}

/// Étude d'un module par un routier (information de suivi, jamais une maîtrise ni une validation).
/// Enregistrée par un chef (routier avec ou sans compte) ou déclarée par le routier lui-même.
/// Jamais supprimée : une saisie erronée est annulée avec motif.
model ModuleStudy {
  id              String    @id @default(uuid(7)) @db.Uuid
  scoutProfileId  String    @map("scout_profile_id") @db.Uuid
  moduleId        String    @map("module_id") @db.Uuid
  moduleVersionId String?   @map("module_version_id") @db.Uuid
  mode            StudyMode
  studiedOn       DateTime  @map("studied_on") @db.Date
  activityId      String?   @map("activity_id") @db.Uuid
  observation     String?
  recordedById    String    @map("recorded_by_id") @db.Uuid
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledById   String?   @map("cancelled_by_id") @db.Uuid
  cancelReason    String?   @map("cancel_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  scoutProfile  ScoutProfile         @relation(fields: [scoutProfileId], references: [id], onDelete: Restrict)
  module        PedagogicalModule    @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  moduleVersion ModuleVersion?       @relation(fields: [moduleVersionId], references: [id], onDelete: Restrict)
  activity      Activity?            @relation(fields: [activityId], references: [id], onDelete: Restrict)
  recordedBy    User                 @relation("ModuleStudyRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  cancelledBy   User?                @relation("ModuleStudyCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  evidences     CompetencyEvidence[]

  @@unique([scoutProfileId, moduleId, studiedOn, mode], map: "module_studies_one_active", where: raw("cancelled_at IS NULL"))
  @@index([scoutProfileId, studiedOn])
  @@index([moduleId])
  @@index([moduleVersionId])
  @@index([activityId])
  @@index([recordedById])
  @@index([cancelledById])
  @@map("module_studies")
}

/// Catégorie utilisée par le programme annuel (ex. « Novices Routiers »). Sa correspondance avec
/// une étape du manuel n'est pas présumée : elle reste « à confirmer » tant que le responsable ne l'a
/// pas validée, et aucune règle automatique n'en dépend.
model ProgrammeCategory {
  id                      String   @id @default(uuid(7)) @db.Uuid
  code                    String   @unique
  label                   String   @unique
  /// Étape correspondante proposée (null = aucune).
  stageId                 String?  @map("stage_id") @db.Uuid
  correspondenceValidated Boolean  @default(false) @map("correspondence_validated")
  position                Int      @unique
  updatedById             String?  @map("updated_by_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stage      ProgressionStage?  @relation(fields: [stageId], references: [id], onDelete: Restrict)
  updatedBy  User?              @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  activities ActivityCategory[]

  @@index([stageId])
  @@map("programme_categories")
}

/// Programme annuel (ex. 2026–2027). Les séances sont des activités d'origine PROGRAMME.
model Programme {
  id        String    @id @default(uuid(7)) @db.Uuid
  code      String    @unique
  title     String
  startsOn  DateTime? @map("starts_on") @db.Date
  endsOn    DateTime? @map("ends_on") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  activities Activity[]

  @@map("programmes")
}

enum ActivityOrigin {
  PROGRAMME
  SUPPLEMENTAIRE
}

enum ActivityStatus {
  PLANIFIEE
  REPORTEE
  REALISEE
  ANNULEE
}

enum ActivityAction {
  CREEE
  IMPORTEE
  MODIFIEE
  STATUT_MODIFIE
  PRESENCES_ENREGISTREES
}

/// Activité (séance du programme annuel ou activité supplémentaire). Jamais supprimée : annulée.
model Activity {
  id               String         @id @default(uuid(7)) @db.Uuid
  programmeId      String?        @map("programme_id") @db.Uuid
  origin           ActivityOrigin
  /// Clé d'import idempotent (date + titre normalisé) ; null pour une activité saisie à la main.
  importKey        String?        @unique @map("import_key")
  title            String
  theme            String?
  description      String         @default("")
  objectives       String[]
  plannedOn        DateTime       @map("planned_on") @db.Date
  plannedLocation  String?        @map("planned_location")
  /// Responsable de l'activité (libellé libre : la personne peut ne pas avoir de compte).
  leaderLabel      String?        @map("leader_label")
  status           ActivityStatus @default(PLANIFIEE)
  heldOn           DateTime?      @map("held_on") @db.Date
  location         String?
  contentDone      String?        @map("content_done")
  difficulties     String?
  observations     String?
  report           String?
  statusReason     String?        @map("status_reason")
  /// Renseigné dès qu'une modification manuelle touche une activité importée : l'import ne la remplace plus.
  manuallyEditedAt DateTime?      @map("manually_edited_at") @db.Timestamptz(3)
  revision         Int            @default(1)
  createdById      String         @map("created_by_id") @db.Uuid
  updatedById      String?        @map("updated_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  programme    Programme?           @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  createdBy    User                 @relation("ActivityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?                @relation("ActivityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  categories   ActivityCategory[]
  modules      ActivityModule[]
  competencies ActivityCompetency[]
  events       ActivityEvent[]
  attendances  ActivityAttendance[]
  studies      ModuleStudy[]
  evidences    CompetencyEvidence[]

  @@index([plannedOn])
  @@index([status, plannedOn])
  @@index([programmeId])
  @@index([createdById])
  @@index([updatedById])
  @@map("activities")
}

model ActivityCategory {
  activityId String @map("activity_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  activity Activity          @relation(fields: [activityId], references: [id], onDelete: Restrict)
  category ProgrammeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([activityId, categoryId])
  @@index([categoryId])
  @@map("activity_categories")
}

model ActivityModule {
  activityId String @map("activity_id") @db.Uuid
  moduleId   String @map("module_id") @db.Uuid

  activity Activity          @relation(fields: [activityId], references: [id], onDelete: Restrict)
  module   PedagogicalModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@id([activityId, moduleId])
  @@index([moduleId])
  @@map("activity_modules")
}

/// Compétence visée (prévue) ou observée pendant l'activité.
model ActivityCompetency {
  activityId   String  @map("activity_id") @db.Uuid
  competencyId String  @map("competency_id") @db.Uuid
  observed     Boolean @default(false)

  activity   Activity   @relation(fields: [activityId], references: [id], onDelete: Restrict)
  competency Competency @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@id([activityId, competencyId])
  @@index([competencyId])
  @@map("activity_competencies")
}

/// Historique des modifications sensibles d'une activité (ajout seul, trigger).
model ActivityEvent {
  id         String          @id @default(uuid(7)) @db.Uuid
  activityId String          @map("activity_id") @db.Uuid
  actorId    String          @map("actor_id") @db.Uuid
  action     ActivityAction
  fromStatus ActivityStatus? @map("from_status")
  toStatus   ActivityStatus? @map("to_status")
  comment    String?
  changes    Json?
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  actor    User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([activityId, createdAt])
  @@index([actorId])
  @@map("activity_events")
}

/// Présence d'un routier à une activité. L'absence de ligne signifie « non renseigné » (jamais
/// « absent » par défaut). Une seule ligne par routier et par activité.
enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSE
}

model ActivityAttendance {
  id             String           @id @default(uuid(7)) @db.Uuid
  activityId     String           @map("activity_id") @db.Uuid
  scoutProfileId String           @map("scout_profile_id") @db.Uuid
  status         AttendanceStatus
  note           String?
  recordedById   String           @map("recorded_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  activity     Activity     @relation(fields: [activityId], references: [id], onDelete: Restrict)
  scoutProfile ScoutProfile @relation(fields: [scoutProfileId], references: [id], onDelete: Restrict)
  recordedBy   User         @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([activityId, scoutProfileId])
  @@index([scoutProfileId])
  @@index([recordedById])
  @@map("activity_attendances")
}
