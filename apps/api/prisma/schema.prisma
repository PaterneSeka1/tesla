// Schéma de Nikola Tesla Académie.
// Conventions : identifiants UUID v7, tables/colonnes en snake_case, dates en UTC (timestamptz).
// Voir docs/DATABASE.md avant toute modification.

generator client {
  provider            = "prisma-client"
  previewFeatures     = ["partialIndexes"]
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Rôles applicatifs (synchronisés avec @tesla/shared ROLES).
enum Role {
  ROUTIER
  CHEF
  RESPONSABLE
}

/// Compte utilisateur. Un compte n'est jamais supprimé : il est désactivé (isActive = false).
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  /// Stocké en minuscules (normalisation applicative).
  email        String    @unique
  /// Hash du mot de passe (algorithme défini en phase authentification). Null tant que le compte n'est pas activé.
  passwordHash String?   @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  role         Role
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions     Session[]
  scoutProfile ScoutProfile?
  auditLogs    AuditLog[]

  teamAssignmentsMade  TeamAssignment[]           @relation("TeamAssignmentAssignedBy")
  teamAssignmentsEnded TeamAssignment[]           @relation("TeamAssignmentEndedBy")
  evaluationsPublished EvaluationVersion[]        @relation("EvaluationVersionPublishedBy")
  attemptsCreated      EvaluationAttempt[]        @relation("AttemptCreatedBy")
  attemptsRecorded     EvaluationAttempt[]        @relation("AttemptRecordedBy")
  attemptsDecided      EvaluationAttempt[]        @relation("AttemptDecidedBy")
  attemptEvents        EvaluationAttemptEvent[]
  waiversGranted       EvaluationWaiver[]         @relation("WaiverGrantedBy")
  waiversRevoked       EvaluationWaiver[]         @relation("WaiverRevokedBy")
  observationsWritten  ScoutObservation[]
  observationRevisions ScoutObservationRevision[]

  modulesCreated             PedagogicalModule[]  @relation("ModuleCreatedBy")
  moduleVersionsCreated      ModuleVersion[]      @relation("ModuleVersionCreatedBy")
  moduleVersionsUpdated      ModuleVersion[]      @relation("ModuleVersionUpdatedBy")
  moduleVersionsSubmitted    ModuleVersion[]      @relation("ModuleVersionSubmittedBy")
  moduleVersionsApproved     ModuleVersion[]      @relation("ModuleVersionApprovedBy")
  moduleVersionsPublished    ModuleVersion[]      @relation("ModuleVersionPublishedBy")
  moduleLessonsCreated       ModuleLesson[]       @relation("ModuleLessonCreatedBy")
  moduleLessonsUpdated       ModuleLesson[]       @relation("ModuleLessonUpdatedBy")
  moduleResourcesCreated     ModuleResource[]
  moduleCollaborations       ModuleCollaborator[] @relation("ModuleCollaboratorUser")
  moduleCollaboratorsAdded   ModuleCollaborator[] @relation("ModuleCollaboratorAddedBy")
  moduleCollaboratorsRemoved ModuleCollaborator[] @relation("ModuleCollaboratorRemovedBy")
  moduleVersionEvents        ModuleVersionEvent[]

  @@index([role])
  @@map("users")
}

/// Session serveur (cookie httpOnly). Seul le hash du jeton est stocké.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Profil routier : référence métier (identité, matricule, équipe, progression, résultats).
/// Existe indépendamment de tout compte : `userId` est facultatif et rattachable plus tard (RM-001).
model ScoutProfile {
  id             String    @id @default(uuid(7)) @db.Uuid
  /// Compte de connexion facultatif (relation 1–1). Le rattachement ne crée jamais de second profil.
  userId         String?   @unique @map("user_id") @db.Uuid
  /// Matricule scout : chaîne normalisée (voir normalizeMatricule dans @tesla/shared), unique si renseigné (RM-002).
  matricule      String?   @unique
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  /// Utilisée uniquement pour les durées d'étape dépendant de l'âge (règle à arbitrer).
  birthDate      DateTime? @map("birth_date") @db.Date
  joinedAt       DateTime  @map("joined_at") @db.Date
  currentStageId String?   @map("current_stage_id") @db.Uuid
  /// Profil désactivé (départ, inactivité) : conservé avec tout son historique, jamais supprimé.
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  currentStage       ProgressionStage?   @relation(fields: [currentStageId], references: [id], onDelete: Restrict)
  teamAssignments    TeamAssignment[]
  evaluationAttempts EvaluationAttempt[]
  evaluationWaivers  EvaluationWaiver[]
  observations       ScoutObservation[]

  @@index([currentStageId])
  @@index([isActive])
  @@index([lastName, firstName])
  @@map("scout_profiles")
}

/// Référentiel des étapes de progression (Noviciat → Départ routier).
/// Les durées dépendent de l'âge et ne sont pas encore modélisées (arbitrage en attente).
model ProgressionStage {
  id             String   @id @default(uuid(7)) @db.Uuid
  code           String   @unique
  name           String
  /// Libellé utilisé dans le programme annuel (ex. « Novices Routiers »).
  programmeLabel String   @map("programme_label")
  badge          String?
  position       Int      @unique
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  scoutProfiles  ScoutProfile[]
  evaluations    Evaluation[]
  moduleVersions ModuleVersion[]

  @@map("progression_stages")
}

/// Journal d'audit en ajout seul : aucune mise à jour ni suppression applicative.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Null pour une action système (seed, tâche planifiée).
  actorId    String?  @map("actor_id") @db.Uuid
  /// Format « domaine.action », ex. « module.approved ».
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Équipe de la Communauté Nikola Tesla. Jamais supprimée : archivée (archivedAt).
model Team {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @unique
  description String?
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments TeamAssignment[]

  @@map("teams")
}

/// Historique des affectations d'un routier à une équipe (RM-003, RM-004).
/// Une seule affectation ouverte (endedAt null) par routier ; périodes sans chevauchement
/// (contrainte d'exclusion PostgreSQL ajoutée en SQL, voir docs/DATABASE.md).
model TeamAssignment {
  id             String    @id @default(uuid(7)) @db.Uuid
  scoutProfileId String    @map("scout_profile_id") @db.Uuid
  teamId         String    @map("team_id") @db.Uuid
  startedAt      DateTime  @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(3)
  /// Auteur de l'affectation (null = action système, ex. reprise de données).
  assignedById   String?   @map("assigned_by_id") @db.Uuid
  endedById      String?   @map("ended_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  scoutProfile ScoutProfile @relation(fields: [scoutProfileId], references: [id], onDelete: Restrict)
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  assignedBy   User?        @relation("TeamAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  endedBy      User?        @relation("TeamAssignmentEndedBy", fields: [endedById], references: [id], onDelete: Restrict)

  @@unique([scoutProfileId], map: "team_assignments_one_open_per_scout", where: raw("ended_at IS NULL"))
  @@index([scoutProfileId, startedAt])
  @@index([teamId])
  @@map("team_assignments")
}

/// Mode de passation d'une évaluation.
enum EvaluationMode {
  EN_LIGNE
  HORS_LIGNE
  PAPIER
}

/// Cycle de vie d'une tentative. VALIDEE/REFUSEE = décision pédagogique du responsable sur ce résultat,
/// distincte de la validation officielle d'une étape (jamais déclenchée automatiquement).
enum AttemptStatus {
  PREPAREE
  EN_COURS
  A_CORRIGER
  SOUMISE
  VALIDEE
  REFUSEE
  ANNULEE
}

/// Évaluation rattachée à une étape de progression (condition d'éligibilité, RM-009).
/// Le lien vers le module de cours sera ajouté avec le modèle Module (phase 2).
model Evaluation {
  id        String   @id @default(uuid(7)) @db.Uuid
  title     String
  stageId   String   @map("stage_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stage    ProgressionStage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  versions EvaluationVersion[]
  attempts EvaluationAttempt[]
  waivers  EvaluationWaiver[]

  @@index([stageId])
  @@map("evaluations")
}

/// Version figée d'un questionnaire. Une version publiée n'est plus modifiée : toute évolution crée une nouvelle version.
model EvaluationVersion {
  id            String    @id @default(uuid(7)) @db.Uuid
  evaluationId  String    @map("evaluation_id") @db.Uuid
  version       Int
  /// Questions affichées au routier (sans réponses attendues).
  questions     Json
  /// Corrigé et barème : réservés aux chefs et au responsable, jamais imprimés sur la feuille du routier.
  answerKey     Json?     @map("answer_key")
  /// Publication après approbation du responsable (workflow développé en phase 2).
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  publishedById String?   @map("published_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  evaluation  Evaluation          @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  publishedBy User?               @relation("EvaluationVersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  attempts    EvaluationAttempt[]

  @@unique([evaluationId, version])
  /// Cible de la clé étrangère composite des tentatives (cohérence version ↔ évaluation).
  @@unique([id, evaluationId])
  @@map("evaluation_versions")
}

/// Tentative d'évaluation, quel que soit le mode (RM-006 à RM-008, RM-011).
/// Référence le profil routier, jamais seulement le compte. `code` est attribué par le backend,
/// unique et immuable (trigger SQL) ; la tentative n'est jamais supprimée (annulation = statut ANNULEE).
model EvaluationAttempt {
  id                  String         @id @default(uuid(7)) @db.Uuid
  /// Code public de référence, ex. « NT-2027-000125 » (RM-007). N'est pas un secret.
  code                String         @unique
  scoutProfileId      String         @map("scout_profile_id") @db.Uuid
  evaluationId        String         @map("evaluation_id") @db.Uuid
  evaluationVersionId String         @map("evaluation_version_id") @db.Uuid
  mode                EvaluationMode
  status              AttemptStatus  @default(PREPAREE)
  /// Date prévue de passation (feuille papier).
  plannedFor          DateTime?      @map("planned_for") @db.Date
  /// Date de réalisation par le routier.
  completedAt         DateTime?      @map("completed_at") @db.Timestamptz(3)
  /// Date d'enregistrement du résultat dans l'application.
  recordedAt          DateTime?      @map("recorded_at") @db.Timestamptz(3)
  answers             Json?
  score               Decimal?       @db.Decimal(7, 2)
  maxScore            Decimal?       @map("max_score") @db.Decimal(7, 2)
  observations        String?
  /// Clé de stockage de la copie numérisée (stockage des fichiers non encore développé).
  evidenceFileKey     String?        @map("evidence_file_key")
  /// Dérogation ayant permis la préparation hors progression, le cas échéant.
  waiverId            String?        @map("waiver_id") @db.Uuid
  createdById         String         @map("created_by_id") @db.Uuid
  recordedById        String?        @map("recorded_by_id") @db.Uuid
  decidedById         String?        @map("decided_by_id") @db.Uuid
  decidedAt           DateTime?      @map("decided_at") @db.Timestamptz(3)
  decisionComment     String?        @map("decision_comment")
  cancelledAt         DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancelReason        String?        @map("cancel_reason")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  scoutProfile ScoutProfile             @relation(fields: [scoutProfileId], references: [id], onDelete: Restrict)
  evaluation   Evaluation               @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  version      EvaluationVersion        @relation(fields: [evaluationVersionId, evaluationId], references: [id, evaluationId], onDelete: Restrict)
  waiver       EvaluationWaiver?        @relation(fields: [waiverId], references: [id], onDelete: Restrict)
  createdBy    User                     @relation("AttemptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  recordedBy   User?                    @relation("AttemptRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  decidedBy    User?                    @relation("AttemptDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  events       EvaluationAttemptEvent[]

  /// Prévention des doublons (RM-012) : une seule tentative non clôturée par routier et par évaluation.
  /// Prédicat écrit sous la forme canonique de PostgreSQL pour éviter une fausse dérive du diff Prisma.
  @@unique([scoutProfileId, evaluationId], map: "evaluation_attempts_one_open_per_scout", where: raw("status = ANY (ARRAY['PREPAREE'::\"AttemptStatus\", 'EN_COURS'::\"AttemptStatus\", 'A_CORRIGER'::\"AttemptStatus\", 'SOUMISE'::\"AttemptStatus\"])"))
  @@index([scoutProfileId, createdAt])
  @@index([evaluationId])
  @@index([evaluationVersionId, evaluationId])
  @@index([status])
  @@index([waiverId])
  @@map("evaluation_attempts")
}

/// Historique en ajout seul d'une tentative : changements de statut, saisies et corrections (réponses originales conservées).
model EvaluationAttemptEvent {
  id         String         @id @default(uuid(7)) @db.Uuid
  attemptId  String         @map("attempt_id") @db.Uuid
  actorId    String         @map("actor_id") @db.Uuid
  fromStatus AttemptStatus? @map("from_status")
  toStatus   AttemptStatus  @map("to_status")
  /// Motif obligatoire pour une correction après soumission, une annulation ou une réouverture.
  reason     String?
  /// Valeurs saisies à ce moment (réponses, score, observations, date de réalisation).
  snapshot   Json?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  attempt EvaluationAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  actor   User              @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([attemptId, createdAt])
  @@index([actorId])
  @@map("evaluation_attempt_events")
}

/// Compteur annuel des codes de tentative (RM-007). Incrémenté atomiquement dans la transaction de création.
model AttemptCodeCounter {
  year      Int      @id
  lastValue Int      @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("attempt_code_counters")
}

/// Dérogation (déblocage individuel) accordée par le responsable pour une évaluation hors progression (RM-009).
model EvaluationWaiver {
  id               String    @id @default(uuid(7)) @db.Uuid
  scoutProfileId   String    @map("scout_profile_id") @db.Uuid
  evaluationId     String    @map("evaluation_id") @db.Uuid
  reason           String
  grantedById      String    @map("granted_by_id") @db.Uuid
  grantedAt        DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById      String?   @map("revoked_by_id") @db.Uuid
  revocationReason String?   @map("revocation_reason")

  scoutProfile ScoutProfile        @relation(fields: [scoutProfileId], references: [id], onDelete: Restrict)
  evaluation   Evaluation          @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  grantedBy    User                @relation("WaiverGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy    User?               @relation("WaiverRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  attempts     EvaluationAttempt[]

  @@index([scoutProfileId, evaluationId])
  @@index([evaluationId])
  @@map("evaluation_waivers")
}

/// Niveau d'accès d'une observation pédagogique (aucune observation n'est visible des routiers).
enum ObservationVisibility {
  /// Chefs et responsable.
  ENCADREMENT
  /// Responsable et auteur uniquement.
  RESPONSABLE
}

/// Observation d'accompagnement saisie par un chef ou le responsable sur un routier.
/// Information pédagogique, jamais une validation officielle. Jamais supprimée (trigger) ;
/// chaque modification conserve l'état précédent dans `scout_observation_revisions`.
model ScoutObservation {
  id             String                @id @default(uuid(7)) @db.Uuid
  scoutProfileId String                @map("scout_profile_id") @db.Uuid
  authorId       String                @map("author_id") @db.Uuid
  /// Date de l'observation (fait observé), distincte de la date de saisie.
  observedOn     DateTime              @map("observed_on") @db.Date
  content        String
  /// Libellé libre facultatif (aucune liste de catégories n'a été arbitrée).
  category       String?
  visibility     ObservationVisibility @default(ENCADREMENT)
  /// Date de la dernière modification du contenu (null si jamais modifiée).
  editedAt       DateTime?             @map("edited_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  scoutProfile ScoutProfile               @relation(fields: [scoutProfileId], references: [id], onDelete: Restrict)
  author       User                       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  revisions    ScoutObservationRevision[]

  @@index([scoutProfileId, observedOn])
  @@index([authorId])
  @@map("scout_observations")
}

/// État d'une observation avant chaque modification (ajout seul, trigger SQL).
model ScoutObservationRevision {
  id            String                @id @default(uuid(7)) @db.Uuid
  observationId String                @map("observation_id") @db.Uuid
  /// Auteur de la modification ayant remplacé cet état.
  editorId      String                @map("editor_id") @db.Uuid
  observedOn    DateTime              @map("observed_on") @db.Date
  content       String
  category      String?
  visibility    ObservationVisibility
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  observation ScoutObservation @relation(fields: [observationId], references: [id], onDelete: Restrict)
  editor      User             @relation(fields: [editorId], references: [id], onDelete: Restrict)

  @@index([observationId, createdAt])
  @@index([editorId])
  @@map("scout_observation_revisions")
}

/// État éditorial d'une version de module (docs/FEATURES/WORKFLOW_PUBLICATION.md).
/// Seul le responsable fait passer une version de SOUMIS à APPROUVE, A_CORRIGER ou REFUSE, puis à PUBLIE ou ARCHIVE.
enum ModuleVersionStatus {
  BROUILLON
  SOUMIS
  A_CORRIGER
  REFUSE
  APPROUVE
  PUBLIE
  ARCHIVE
}

/// Action enregistrée dans l'historique d'une version (ajout seul).
enum ModuleVersionAction {
  CREEE
  SOUMISE
  REPRISE
  CORRECTIONS_DEMANDEES
  REFUSEE
  APPROUVEE
  PUBLIEE
  REMPLACEE
  ARCHIVEE
}

/// Nature d'une ressource pédagogique : toujours une URL externe (aucun fichier lourd stocké sur le serveur).
enum ModuleResourceKind {
  IMAGE
  DOCUMENT
  VIDEO
  LIEN
}

/// Module pédagogique stable. Son contenu est porté par ses versions ; seule la version désignée par
/// `publishedVersionId` est visible des routiers.
model PedagogicalModule {
  id                 String   @id @default(uuid(7)) @db.Uuid
  /// Numéro séquentiel attribué par PostgreSQL ; code interne affiché « MOD-001 ».
  number             Int      @unique @default(autoincrement())
  /// Identifiant d'URL fixé à la création, stable même si le titre change dans une version ultérieure.
  slug               String   @unique
  createdById        String   @map("created_by_id") @db.Uuid
  /// Version publiée courante (au plus une ; null = module invisible des routiers).
  publishedVersionId String?  @unique @map("published_version_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy        User                 @relation("ModuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedVersion ModuleVersion?       @relation("ModulePublishedVersion", fields: [publishedVersionId], references: [id], onDelete: Restrict)
  versions         ModuleVersion[]      @relation("ModuleVersions")
  collaborators    ModuleCollaborator[]
  events           ModuleVersionEvent[]

  @@index([createdById])
  @@map("pedagogical_modules")
}

/// Version éditoriale d'un module. Modifiable uniquement à l'état BROUILLON (trigger SQL) ;
/// toute modification d'un module publié passe par une nouvelle version.
model ModuleVersion {
  id               String              @id @default(uuid(7)) @db.Uuid
  moduleId         String              @map("module_id") @db.Uuid
  version          Int
  status           ModuleVersionStatus @default(BROUILLON)
  title            String
  summary          String              @default("")
  objectives       String[]
  prerequisites    String?
  /// Durée indicative en minutes.
  durationMinutes  Int?                @map("duration_minutes")
  /// Étape recommandée (information de lecture : la consultation n'est jamais bloquée par la progression).
  stageId          String?             @map("stage_id") @db.Uuid
  /// Thème : libellé libre facultatif (aucune liste officielle arbitrée).
  theme            String?
  /// Contrôle de concurrence optimiste : incrémenté à chaque modification des informations du brouillon.
  revision         Int                 @default(1)
  /// Version dont le contenu a été repris à la création.
  basedOnVersionId String?             @map("based_on_version_id") @db.Uuid
  createdById      String              @map("created_by_id") @db.Uuid
  updatedById      String?             @map("updated_by_id") @db.Uuid
  submittedAt      DateTime?           @map("submitted_at") @db.Timestamptz(3)
  submittedById    String?             @map("submitted_by_id") @db.Uuid
  submissionNote   String?             @map("submission_note")
  approvedAt       DateTime?           @map("approved_at") @db.Timestamptz(3)
  approvedById     String?             @map("approved_by_id") @db.Uuid
  publishedAt      DateTime?           @map("published_at") @db.Timestamptz(3)
  publishedById    String?             @map("published_by_id") @db.Uuid
  /// Date de retrait (archivage ou remplacement par une nouvelle version publiée).
  archivedAt       DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  module          PedagogicalModule    @relation("ModuleVersions", fields: [moduleId], references: [id], onDelete: Restrict)
  publishedFor    PedagogicalModule?   @relation("ModulePublishedVersion")
  stage           ProgressionStage?    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  basedOn         ModuleVersion?       @relation("ModuleVersionBasedOn", fields: [basedOnVersionId], references: [id], onDelete: Restrict)
  derivedVersions ModuleVersion[]      @relation("ModuleVersionBasedOn")
  createdBy       User                 @relation("ModuleVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User?                @relation("ModuleVersionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  submittedBy     User?                @relation("ModuleVersionSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  approvedBy      User?                @relation("ModuleVersionApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  publishedBy     User?                @relation("ModuleVersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  lessons         ModuleLesson[]
  resources       ModuleResource[]
  events          ModuleVersionEvent[]

  @@unique([moduleId, version])
  /// Une seule version de travail (non close) par module.
  @@unique([moduleId], map: "module_versions_one_working_per_module", where: raw("status = ANY (ARRAY['BROUILLON'::\"ModuleVersionStatus\", 'SOUMIS'::\"ModuleVersionStatus\", 'A_CORRIGER'::\"ModuleVersionStatus\", 'APPROUVE'::\"ModuleVersionStatus\"])"))
  /// Une seule version publiée par module.
  @@unique([moduleId], map: "module_versions_one_published_per_module", where: raw("status = 'PUBLIE'::\"ModuleVersionStatus\""))
  @@index([status])
  @@index([stageId])
  @@index([basedOnVersionId])
  @@map("module_versions")
}

/// Leçon ordonnée d'une version. Contenu : document structuré (JSON) validé par liste blanche, jamais du HTML.
model ModuleLesson {
  id              String   @id @default(uuid(7)) @db.Uuid
  versionId       String   @map("version_id") @db.Uuid
  /// Rang dans la version (0, 1, 2…), maintenu contigu par le service.
  position        Int
  title           String
  content         Json
  durationMinutes Int?     @map("duration_minutes")
  /// Contrôle de concurrence optimiste de la leçon.
  revision        Int      @default(1)
  createdById     String   @map("created_by_id") @db.Uuid
  updatedById     String?  @map("updated_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  version   ModuleVersion    @relation(fields: [versionId], references: [id], onDelete: Restrict)
  createdBy User             @relation("ModuleLessonCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?            @relation("ModuleLessonUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  resources ModuleResource[]

  @@index([versionId, position])
  @@index([createdById])
  @@index([updatedById])
  @@map("module_lessons")
}

/// Ressource associée à une version (ou à une de ses leçons) : URL externe uniquement.
model ModuleResource {
  id          String             @id @default(uuid(7)) @db.Uuid
  versionId   String             @map("version_id") @db.Uuid
  /// Null = ressource du module ; sinon ressource de la leçon.
  lessonId    String?            @map("lesson_id") @db.Uuid
  kind        ModuleResourceKind
  title       String
  url         String
  description String?
  createdById String             @map("created_by_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  version   ModuleVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  lesson    ModuleLesson? @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  createdBy User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([versionId])
  @@index([lessonId])
  @@index([createdById])
  @@map("module_resources")
}

/// Chef autorisé à rédiger un module (en plus de son auteur). Retrait daté, jamais supprimé.
model ModuleCollaborator {
  id          String    @id @default(uuid(7)) @db.Uuid
  moduleId    String    @map("module_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  addedById   String    @map("added_by_id") @db.Uuid
  removedAt   DateTime? @map("removed_at") @db.Timestamptz(3)
  removedById String?   @map("removed_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  module    PedagogicalModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  user      User              @relation("ModuleCollaboratorUser", fields: [userId], references: [id], onDelete: Restrict)
  addedBy   User              @relation("ModuleCollaboratorAddedBy", fields: [addedById], references: [id], onDelete: Restrict)
  removedBy User?             @relation("ModuleCollaboratorRemovedBy", fields: [removedById], references: [id], onDelete: Restrict)

  @@unique([moduleId, userId], map: "module_collaborators_one_active", where: raw("removed_at IS NULL"))
  @@index([userId])
  @@index([addedById])
  @@index([removedById])
  @@map("module_collaborators")
}

/// Historique des versions et des décisions (ajout seul, trigger SQL).
model ModuleVersionEvent {
  id         String               @id @default(uuid(7)) @db.Uuid
  moduleId   String               @map("module_id") @db.Uuid
  versionId  String               @map("version_id") @db.Uuid
  actorId    String               @map("actor_id") @db.Uuid
  action     ModuleVersionAction
  fromStatus ModuleVersionStatus? @map("from_status")
  toStatus   ModuleVersionStatus  @map("to_status")
  /// Motif (obligatoire pour une demande de correction, un refus ou un archivage) ou note de soumission.
  comment    String?
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  module  PedagogicalModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  version ModuleVersion     @relation(fields: [versionId], references: [id], onDelete: Restrict)
  actor   User              @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([moduleId, createdAt])
  @@index([versionId, createdAt])
  @@index([actorId])
  @@index([createdAt])
  @@map("module_version_events")
}
