# ─────────────────────────────────────────────────────────────
# Nikola Tesla Académie — variables d'environnement (développement)
# Copier ce fichier en `.env` à la racine. Ne jamais versionner `.env`.
# Les valeurs ci-dessous sont des valeurs locales fictives.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (Docker Compose)
POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla_dev_password
POSTGRES_DB=tesla
POSTGRES_PORT=5433

# API NestJS
NODE_ENV=development
API_PORT=4000
# Interface d'écoute de l'API (127.0.0.1 en production derrière Nginx)
API_HOST=0.0.0.0
DATABASE_URL=postgresql://tesla:tesla_dev_password@localhost:5433/tesla?schema=public
# Tests d'intégration uniquement (npm run test:int -w @tesla/api) : base dédiée dont le nom finit par « _test »,
# migrée puis vidée par les tests. Ne jamais pointer vers la base de développement.
# TEST_DATABASE_URL=postgresql://tesla:tesla_dev_password@localhost:5433/tesla_test?schema=public
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:3000
# Swagger exposé sur /api/docs (désactivé par défaut en production)
SWAGGER_ENABLED=true
# Durée de vie absolue d'une session, en heures (cookie httpOnly, Secure en production)
SESSION_TTL_HOURS=12
# Validité, en heures, d'un lien d'activation ou de réinitialisation du mot de passe (usage unique)
ACCOUNT_LINK_TTL_HOURS=72
# Validité, en minutes, d'une demande « mot de passe oublié » en libre-service (D166)
PASSWORD_RESET_TTL_MINUTES=60
# Envoi facultatif des liens d'activation et de récupération par e-mail (D166). Tout ou rien :
# SMTP_HOST, SMTP_FROM et PUBLIC_APP_URL ensemble. Absent : récupération administrée, aucun e-mail.
# SMTP_SECURE=true pour TLS implicite (465) ; false = STARTTLS obligatoire (587).
# PUBLIC_APP_URL=http://localhost:3000
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Nikola Tesla Académie <no-reply@example.org>"
# true derrière Nginx : adresse IP réelle du client pour la limitation des tentatives de connexion
TRUST_PROXY=false
# Clé de chiffrement des fiches médicales : 32 octets en base64 (openssl rand -base64 32).
# Obligatoire en production, à sauvegarder hors de la base (sans elle, les fiches sont illisibles).
# Absente en développement : les fiches médicales sont indisponibles.
# MEDICAL_DATA_KEY=
# Stockage objet des fichiers joints (Cloudflare R2, compatible S3 ; docs/STORAGE_R2.md).
# Facultatif : sans ces variables, l'envoi et la lecture des fichiers répondent 503, le reste
# fonctionne. Tout ou rien : une configuration partielle bloque le démarrage. Compartiment de
# développement distinct de la production ; jeton limité à ce seul compartiment (Object Read & Write).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=tesla-files-dev
# Facultatif : déduit de R2_ACCOUNT_ID (https://<compte>.r2.cloudflarestorage.com) ; autre fournisseur S3.
# R2_ENDPOINT=
# R2_REGION=auto
# Préfixe des clés d'objet (défaut : NODE_ENV)
# R2_KEY_PREFIX=development
# Plafond global d'un fichier en octets (défaut 20 Mio ; images 5 Mo et PDF 20 Mo au plus)
# R2_UPLOAD_MAX_BYTES=20971520
# Validité des URL signées d'envoi et de lecture, en secondes (60 à 3600)
# R2_SIGNED_URL_EXPIRATION=300
# Seed de développement uniquement : mot de passe (≥ 12 caractères) des comptes de démonstration
# fictifs *.demo@tesla.test. Laisser vide pour n'en créer aucun. Ignoré en production.
# DEMO_ACCOUNT_PASSWORD=

# Frontend Next.js (variables publiques, intégrées au build)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Web sur Vercel (docs/DEPLOYMENT_VERCEL_OVH.md) : NEXT_PUBLIC_API_URL=/api/v1 (appels même
# origine) et, côté serveur Vercel uniquement, l'origine de l'API et le secret partagé avec Nginx
# (/etc/nginx/tesla/<instance>-proxy.conf). Jamais DATABASE_URL ni aucun secret de l'API sur Vercel.
# TESLA_API_ORIGIN=https://api.exemple.org
# TESLA_PROXY_SECRET=
