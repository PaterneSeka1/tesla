# ─────────────────────────────────────────────────────────────
# Nikola Tesla Académie — variables d'environnement (développement)
# Copier ce fichier en `.env` à la racine. Ne jamais versionner `.env`.
# Les valeurs ci-dessous sont des valeurs locales fictives.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (Docker Compose)
POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla_dev_password
POSTGRES_DB=tesla
POSTGRES_PORT=5433

# API NestJS
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://tesla:tesla_dev_password@localhost:5433/tesla?schema=public
# Tests d'intégration uniquement (npm run test:int -w @tesla/api) : base dédiée dont le nom finit par « _test »,
# migrée puis vidée par les tests. Ne jamais pointer vers la base de développement.
# TEST_DATABASE_URL=postgresql://tesla:tesla_dev_password@localhost:5433/tesla_test?schema=public
# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://localhost:3000
# Swagger exposé sur /api/docs (désactivé par défaut en production)
SWAGGER_ENABLED=true
# Durée de vie absolue d'une session, en heures (cookie httpOnly, Secure en production)
SESSION_TTL_HOURS=12
# true derrière Nginx : adresse IP réelle du client pour la limitation des tentatives de connexion
TRUST_PROXY=false
# Seed de développement uniquement : mot de passe (≥ 12 caractères) des comptes de démonstration
# fictifs *.demo@tesla.test. Laisser vide pour n'en créer aucun. Ignoré en production.
# DEMO_ACCOUNT_PASSWORD=

# Frontend Next.js (variables publiques, intégrées au build)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
